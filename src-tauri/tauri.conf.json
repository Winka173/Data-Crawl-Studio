{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Data Crawl Studio",
  "version": "0.1.0",
  "identifier": "io.github.winka173.datacrawlstudio",
  "build": {
    "frontendDist": "../dist-ui",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Data Crawl Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../build/sidecar/": "sidecar/"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
